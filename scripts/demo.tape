Output assets/gh-select-demo.gif
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 15
Set Width 1200
Set Height 680
Set Theme "Catppuccin Mocha"
Set Padding 16
Set Framerate 24
Set TypingSpeed 70ms
Set Shell bash
Hide
Type "export PATH=$PWD:$PATH GH_CONFIG_DIR=${GH_CONFIG_DIR:-$HOME/.config/gh} XDG_CONFIG_HOME=$(mktemp -d); clear"
Enter
Type "gh-select"
Enter
Sleep 3s
Type "is:public "
Sleep 500ms
Show
Sleep 800ms
Type "gh-sel"
Sleep 2s
Tab
Sleep 1.5s
Tab
Sleep 800ms
Escape
Sleep 400ms
Type "charmbracelet bubbletea"
Sleep 3s
Enter
Sleep 1.2s
