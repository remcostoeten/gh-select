Output showcase/public/raw.mp4
Set FontFamily "JetBrainsMono Nerd Font Mono"
Set FontSize 16
Set Width 1200
Set Height 700
Set Theme "Catppuccin Mocha"
Set Padding 16
Set Framerate 30
Set TypingSpeed 40ms
Set Shell bash
Hide
Type "export PATH=$PWD:$PATH GH_CONFIG_DIR=${GH_CONFIG_DIR:-$HOME/.config/gh} XDG_CONFIG_HOME=$(mktemp -d) GH_SELECT_CLONE_DIR=$(mktemp -d) PS1='$ '; cd $(mktemp -d); clear"
Enter
Show
Sleep 400ms
Type "gh select"
Sleep 200ms
Enter
Sleep 1500ms
Type "gh-select"
Sleep 600ms
Enter
Sleep 900ms
Type "5"
Sleep 1500ms
Down 7
Sleep 400ms
Enter
Sleep 1500ms
Type "s"
Sleep 1800ms
Escape
Sleep 400ms
Space
Sleep 250ms
Down
Space
Sleep 800ms
Type "c"
Sleep 5s
Type "clear; gh select"
Enter
Sleep 1200ms
Tab
Sleep 400ms
Tab
Sleep 500ms
Type "charmbracelet bubbletea"
Sleep 2500ms
Enter
Sleep 1800ms
Hide
Ctrl+C
Ctrl+C
