{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/serve.ts dev",
    "build": "bun run sync:changelog && bun run check:links && bun --bun next build",
    "start": "bun scripts/serve.ts start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "postinstall": "bun --bun fumadocs-mdx",
    "typecheck": "bun --bun fumadocs-mdx && bun --bun next typegen && bun --bun tsc --noEmit",
    "sync:changelog": "bun scripts/sync-changelog.ts",
    "test": "bun test",
    "check:links": "bun scripts/check-links.ts",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.86",
    "@ai-sdk/google": "^4.0.103",
    "@ai-sdk/openai": "^4.0.99",
    "@ai-sdk/react": "^4.0.153",
    "@opennextjs/cloudflare": "1.20.15",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@spoar/sdk": "2.3.0",
    "ai": "^7.0.149",
    "clsx": "^2.1.1",
    "fumadocs-core": "^16.17.5",
    "fumadocs-mdx": "^15.4.7",
    "fumadocs-twoslash": "^3.3.1",
    "fumadocs-typescript": "^5.5.2",
    "fumadocs-ui": "^16.17.5",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "lucide-react": "^1.61.0",
    "motion": "^14.3.0",
    "next": "^16.4.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bun": "^1.4.3",
    "@types/hast": "^3.0.5",
    "@types/mdx": "^2.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6",
    "vite-plus": "^1.3.0",
    "wrangler": "4.156.0"
  },
  "engines": {
    "bun": ">=1.3"
  },
  "packageManager": "bun@1.4.3"
}
